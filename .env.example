# Copy to .env.local and fill in. Do NOT commit real values.

# ── AI: site-owned key for the free tier (visitors can also connect their own key in the UI) ──
# Google AI Studio key (https://aistudio.google.com/apikey). Used for the free tier when no
# OPENAI_API_KEY is set. Ambient features (compare chips, blurbs, roles) never use owner keys;
# they run only on a visitor's connected key and otherwise fall back to deterministic behaviour.
GEMINI_API_KEY=
# Optional additional owner keys. The free tier picks OPENAI → GEMINI → ANTHROPIC → OPENROUTER
# unless FREE_TIER_PROVIDER forces one.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
FREE_TIER_PROVIDER=
# Optional per-tier model overrides, e.g. AI_MODEL_OPENAI_SMART=gpt-5 (tiers: FAST, SMART; see modelFor in src/lib/ai/llm.ts).
# Free-tier requests per visitor: the Firebase account when signed in, otherwise a signed device
# cookie (no sign-in required). Default 15. Counted in Firestore `aiQuota` when FIREBASE_ADMIN_* is set, else in memory.
FREE_CHAT_LIMIT=15
# Long random secret (>= 16 chars) that seals visitors' BYOK keys into httpOnly cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AI_COOKIE_SECRET=

# ── Firebase web app config (public; Project settings → General → Your apps) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# ── Firebase Admin (server): optional; nothing breaks without it ──
# Two server-side stores use it, and both degrade to process memory when it is absent: the
# free-tier counter (resets on restart) and the persistent cache in src/lib/cache/ (L1-only,
# per-process, gone on restart instead of shared across instances and surviving cold starts).
# Project settings → Service accounts → Generate new private key. Paste client_email and
# private_key from the JSON; keep the private key's \n escapes on one line.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
