# Copy to .env.local and fill in. Do NOT commit real values.

# ── AI: site-owned key for the free tier (visitors can also connect their own key in the UI) ──
# Google AI Studio key (https://aistudio.google.com/apikey). Used for the free tier when no
# OPENAI_API_KEY is set, and as the model for ambient features when a visitor has no key.
GEMINI_API_KEY=
# Optional additional owner keys. The free tier picks OPENAI → GEMINI → ANTHROPIC → OPENROUTER
# unless FREE_TIER_PROVIDER forces one.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
FREE_TIER_PROVIDER=
# Optional model overrides (defaults in src/lib/ai/llm.ts).
GEMINI_MODEL=
OPENAI_MODEL=
ANTHROPIC_MODEL=
OPENROUTER_MODEL=
FREE_TIER_MODEL=
# Free-tier requests per visitor (Firebase uid, or an anonymous device cookie). Default 10.
FREE_CHAT_LIMIT=15
# Long random secret (>= 16 chars) that seals visitors' BYOK keys into httpOnly cookies.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AI_COOKIE_SECRET=

# ── Firebase web app config (public; Project settings → General → Your apps) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# ── Firebase Admin (server): only needed so the free-tier counter persists in Firestore ──
# Project settings → Service accounts → Generate new private key. Paste client_email and
# private_key from the JSON; keep the private key's \n escapes on one line.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
