rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures
// (source of truth: src/lib/library/types.ts, src/lib/benchmarks/types.ts,
// src/lib/library/firestoreStore.ts).
//
// Collection: users/{uid}/teams
// Document ID: the SavedTeam.id (a client-generated UUID); must equal `id`.
// Written with setDoc (full replace) by the owner only; read with getDoc /
// getDocs on the subcollection. This is the only collection any client ever
// touches, and the only one these rules describe.
//
// Two further collections exist, both written exclusively by the server as the
// service account through the Firestore REST API (src/lib/firebase/server.ts):
//   aiQuota/{identityHash}          free-tier request counter (src/lib/ai/quota.ts)
//   cache/{namespace}/entries/{h}   persistent server cache (src/lib/cache/)
// Service-account calls bypass these rules entirely, so neither needs a rule of
// its own; both are unreachable from any client through the deny-all at the
// bottom of this file, which is deliberate and must stay that way. Neither holds
// user content: a quota document is a count under a hash, and a cache document is
// derived format-wide data (usage pages, computed matrices) that can be deleted
// and recomputed at any time.
//
// Fields:
//   - id: string (required, == document id, ≤ 64) - immutable
//   - ownerUid: string (required, == request.auth.uid) - immutable
//   - name: string (required, 1–100)
//   - team: list (required, exactly 6 entries; each null or a TeamMon map)
//   - blurb: string (required, ≤ 2000)
//   - blurbHash: string (required, ≤ 16)
//   - createdAt: int (required, Unix ms) - immutable
//   - updatedAt: int (required, Unix ms)
//   - regulation: string (optional, 'reg-m-b' | 'reg-m-c')
//
// TeamMon map:
//   - slot: int 1–6; nickname: string ≤ 40 or null; species: string 1–40;
//   - item, ability: optional string ≤ 40; nature: string ≤ 20;
//   - sp: map; moves: list; computedStats: map; role: string ≤ 300;
//   - benchmarks: list ≤ 20.
//   Nested values (SP numbers, move strings, stat numbers, benchmark entries)
//   are not validated: see the note above isValidMon on Firestore's
//   per-request expression budget.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function strMax(v, max) {
      return v is string && v.size() <= max;
    }

    // Per-Pokémon validation is deliberately shallow. Firestore evaluates a bounded number of rule
    // expressions per request (on the order of a thousand); a six-Pokémon team checked
    // field-by-field (six SP keys, six stats, four moves, every benchmark) exceeds it and every
    // save is denied — measured: full checks fail from the 4th Pokémon on. Only the owner can
    // write here, so the rules pin the schema shape (closed key list, slot/species/list/map
    // types, name size caps) and leave value-level checks of the owner's own nested data to the
    // client. Keep this function cheap: every expression here is paid six times per save.
    function isValidMon(m) {
      return m is map
        && m.keys().hasOnly(['slot', 'nickname', 'species', 'item', 'ability', 'nature',
                             'sp', 'moves', 'computedStats', 'role', 'benchmarks'])
        && m.slot is int
        && m.species is string && m.species.size() <= 40
        && m.nature is string
        && m.sp is map
        && m.moves is list
        && m.computedStats is map
        && m.role is string && m.role.size() <= 300
        && m.benchmarks is list && m.benchmarks.size() <= 20;
    }

    function slotAt(team, i) {
      return team[i] == null ? true : isValidMon(team[i]);
    }

    // Exactly six slots, each empty (null) or a fully validated TeamMon.
    function isValidTeamSlots(team) {
      return team is list && team.size() == 6
        && slotAt(team, 0) && slotAt(team, 1) && slotAt(team, 2)
        && slotAt(team, 3) && slotAt(team, 4) && slotAt(team, 5);
    }

    // ===============================================================
    // Domain Validator (used by BOTH create and update)
    // ===============================================================

    function isValidSavedTeam(data, userId, teamId) {
      return data.keys().hasOnly(['id', 'ownerUid', 'name', 'team', 'blurb', 'blurbHash',
                                  'createdAt', 'updatedAt', 'regulation'])
        && data.keys().hasAll(['id', 'ownerUid', 'name', 'team', 'blurb', 'blurbHash',
                               'createdAt', 'updatedAt'])
        && data.id == teamId && strMax(data.id, 64)
        && data.ownerUid == userId
        && strMax(data.name, 100) && data.name.size() >= 1
        && isValidTeamSlots(data.team)
        && strMax(data.blurb, 2000)
        && strMax(data.blurbHash, 16)
        && data.createdAt is int && data.createdAt > 0
        && data.updatedAt is int && data.updatedAt >= data.createdAt
        && (('regulation' in data) ? data.regulation in ['reg-m-b', 'reg-m-c'] : true);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // A user's team library. Private to that user; the parent users/{uid}
    // document is never created or read (no PII stored anywhere).
    match /users/{userId}/teams/{teamId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && isValidSavedTeam(request.resource.data, userId, teamId);

      allow update: if isOwner(userId)
        && isValidSavedTeam(request.resource.data, userId, teamId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.ownerUid == resource.data.ownerUid;

      allow delete: if isOwner(userId);
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
